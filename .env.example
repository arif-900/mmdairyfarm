# Supabase Configuration
# Get from: Supabase Dashboard → Settings → API
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_anon_public_key"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"

# Razorpay Configuration
# Get from: https://razorpay.com → Settings → API Keys (use Test keys for dev)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Supabase Service Role Key (for Edge Functions and AI Agent)
# Get from: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# AI Agent Microservice URL
# Development: http://localhost:3001
# Production: https://your-ai-agent.railway.app (or Render/Fly.io URL)
VITE_AI_AGENT_URL="http://localhost:3001"

# Google Gemini API Configuration
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-1.5-flash"

